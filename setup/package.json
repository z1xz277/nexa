{
  "name": "nexa-setup",
  "version": "1.0.0",
  "private": true,
  "description": "Nexa Windows installer",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "npm run build:assets && node scripts/dev.js",
    "build:assets": "node scripts/copy-fonts.js && node scripts/generate-icons.js",
    "icons": "node scripts/generate-icons.js",
    "payload": "node scripts/payload.js",
    "link": "node scripts/harness-link.js",
    "setup": "node scripts/harness-link.js ..",
    "build": "npm run build:assets && electron-builder --win portable",
    "dist:dir": "npm run build:assets && electron-builder --win --dir",
    "test:contract": "node --test scripts/*.test.js",
    "test": "npm run test:contract && node scripts/smoke-test.js"
  },
  "dependencies": {
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "png-to-ico": "3.0.2",
    "sharp": "^0.34.4"
  },
  "engines": {
    "node": ">=20"
  }
}
